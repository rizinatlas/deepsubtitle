{
  "name": "deepsubtitle",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "deepsubtitle-db", "database_id": "bb1a41d9-4c29-4948-8b3b-2543c0daa4fe", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "deepsubtitle-files" }]
}
